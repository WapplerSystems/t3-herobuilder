plugin.tx_herobuilder {
    view {
        templateRootPath = EXT:herobuilder/Resources/Private/Templates/
        partialRootPath = EXT:herobuilder/Resources/Private/Partials/
        layoutRootPath = EXT:herobuilder/Resources/Private/Layouts/
    }
    settings {
        # Columns (colPos, comma list) whose hero renders without the theme's frame, container,
        # spacing and header — a full-bleed hero area. Empty: every hero uses the Default layout.
        # T3Bootstrap's hero area is colPos 5.
        framelessColPos =
        # Fixed stage aspect ratio per breakpoint (see plan). Format W:H.
        stages {
            xs.ratio = 9:16
            sm.ratio = 3:4
            md.ratio = 16:9
            lg.ratio = 21:9
            xl.ratio = 21:9
            xxl.ratio = 21:9
            xxxl.ratio = 21:9
        }
    }
}
