# Hero Builder — storage folder (sysfolder uid) where "Save as template" stores
# tx_herobuilder_template records. Templates are global (listed regardless of pid).
# Unset by default: the record's own pid is used. Set this per site to collect
# templates in one sysfolder:
#
#   tx_herobuilder.templatePid = 123

# Hero Builder — predefined CSS classes selectable per layer, one list per layer type.
# Key = CSS class (as applied to the layer), value = editor label. Entries directly under
# layerClasses (without text/button/image) apply to every layer type.
# Single source of truth: read by the backend canvas (selection) AND the frontend
# CompositionProcessor (whitelist validation, per type). Override/extend per page as needed.
tx_herobuilder.layerClasses {
    text {
        display-1 = Display 1 (XXL)
        display-3 = Display 3 (XL)
        display-5 = Display 5 (L)
        fs-1 = Schrift sehr groß
        fs-3 = Schrift groß
        fs-5 = Schrift klein
        fw-bold = Fett
        fw-semibold = Halbfett
        fw-light = Leicht
        fst-italic = Kursiv
        text-uppercase = GROSSBUCHSTABEN
        text-white = Weiß
        text-dark = Dunkel
        text-primary = Primärfarbe
        text-bg-primary = Box: Primär
        text-bg-dark = Box: Dunkel
        text-start = Linksbündig
        text-center = Zentriert
        text-end = Rechtsbündig
        lh-1 = Zeilenhöhe eng
    }
    button {
        btn = Button-Basis
        btn-primary = Button: Primär
        btn-secondary = Button: Sekundär
        btn-light = Button: Hell
        btn-outline-light = Button: Outline hell
        btn-lg = Button: groß
    }
    image {
        rounded-3 = Abgerundet
        shadow = Schatten
        opacity-75 = Leicht transparent
    }
}

# Hero Builder — groups for the class chips in the editor (presentation only; the whitelist is
# layerClasses above). classes = comma list; exclusive = 1: selecting one deselects the others;
# background = 1: these classes set the layer background (the text darkening is locked then).
# Offered classes in no group are listed under "More".
tx_herobuilder.layerClassGroups {
    text {
        10 {
            label = Größe
            exclusive = 1
            classes = display-1, display-3, display-5, fs-1, fs-3, fs-5
        }
        20 {
            label = Gewicht
            exclusive = 1
            classes = fw-bold, fw-semibold, fw-light
        }
        30 {
            label = Stil
            classes = fst-italic, text-uppercase, lh-1
        }
        40 {
            label = Farbe
            exclusive = 1
            classes = text-white, text-dark, text-primary
        }
        50 {
            label = Box
            exclusive = 1
            background = 1
            classes = text-bg-primary, text-bg-dark
        }
        60 {
            label = Ausrichtung
            exclusive = 1
            classes = text-start, text-center, text-end
        }
    }
    button {
        10 {
            label = Variante
            exclusive = 1
            classes = btn-primary, btn-secondary, btn-light, btn-outline-light
        }
        20 {
            label = Basis & Größe
            classes = btn, btn-lg
        }
    }
    image {
        10 {
            label = Effekte
            classes = rounded-3, shadow, opacity-75
        }
    }
}

# Stylesheets pulled into the backend live-preview iframe so it looks like the frontend
# (Bootstrap/theme utility classes, fonts). The extension always adds its own hero.css/aos.css.
# Absolute URLs are used as-is; EXT:/site-relative paths are resolved and skipped if missing.
# Override per site in the site root's page TSconfig to match that site's compiled theme.
# No defaults are shipped — a stylesheet path is always site-specific. Example:
#
#   tx_herobuilder.previewCss {
#       10 = /typo3temp/assets/css/mytheme.css
#       20 = EXT:my_sitepackage/Resources/Public/Css/fonts.css
#   }

mod.wizards.newContentElement.wizardItems.common {
    elements {
        herobuilder {
            iconIdentifier = content-herobuilder
            title = LLL:EXT:herobuilder/Resources/Private/Language/locallang_db.xlf:wizard.title
            description = LLL:EXT:herobuilder/Resources/Private/Language/locallang_db.xlf:wizard.description
            tt_content_defValues {
                CType = herobuilder
            }
        }
    }
    show := addToList(herobuilder)
}
