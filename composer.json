{
    "name": "wapplersystems/herobuilder",
    "type": "typo3-cms-extension",
    "description": "Graphical per-breakpoint hero composition builder (drag & drop FAL layers, carousel of collages) for TYPO3.",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "WapplerSystems",
            "email": "typo3@wappler.systems",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.3",
        "typo3/cms-core": "^14.3",
        "typo3/cms-backend": "^14.3",
        "typo3/cms-frontend": "^14.3",
        "typo3/cms-fluid-styled-content": "^14.3"
    },
    "autoload": {
        "psr-4": {
            "WapplerSystems\\Herobuilder\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "herobuilder"
        }
    }
}
